# GAVEL Frontend Environment
#
# Copy this file to .env for local development.
# Do not put backend secrets, database URLs, JWT secrets, SMTP keys, Brevo keys,
# passwords, or private account credentials in frontend env files.
# VITE_* values are exposed to the browser bundle.

# Frontend-safe API base URL, including /api/v1.
VITE_API_BASE_URL=https://your-backend-domain.example.com/api/v1

# Optional local development example:
# VITE_API_BASE_URL=http://localhost:1940/api/v1

